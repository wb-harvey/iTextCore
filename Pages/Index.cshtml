@page
@model UsefulPdfNet.Pages.IndexModel
@{
    ViewData["Title"] = "PDF Form Editor";
}

<div class="editor-container">
    @if (!Model.HasUploadedPdf)
    {
        <!-- ========== UPLOAD STEP ========== -->
        <div class="upload-section">
            <form method="post" enctype="multipart/form-data" asp-page-handler="Upload" id="uploadForm">
                <div class="drop-zone" id="dropZone">
                    <div class="drop-zone-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="17 8 12 3 7 8"/>
                            <line x1="12" y1="3" x2="12" y2="15"/>
                        </svg>
                    </div>
                    <h2 class="drop-zone-title">Upload a PDF Form</h2>
                    <p class="drop-zone-subtitle">Drag and drop your PDF here, or click to browse</p>
                    <input type="file" name="pdfFile" id="pdfFileInput" accept=".pdf" class="file-input" />
                    <label for="pdfFileInput" class="btn btn-primary">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="17 8 12 3 7 8"/>
                            <line x1="12" y1="3" x2="12" y2="15"/>
                        </svg>
                        Choose PDF File
                    </label>
                    <span class="file-name" id="fileName"></span>
                </div>
            </form>
        </div>
    }
    else
    {
        <!-- ========== FIELD EDITOR STEP ========== -->
        <div class="field-editor-section">
            <div class="editor-header">
                <div class="editor-header-info">
                    <h2 class="editor-title">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="title-icon">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                        </svg>
                        Editing: @Model.UploadedFileName
                    </h2>
                    <p class="editor-subtitle">@Model.FormFields.Count form field(s) detected</p>
                </div>
                <div class="editor-actions-top">
                    <a asp-page="/Index" class="btn btn-ghost">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                        New PDF
                    </a>
                </div>
            </div>

            @if (Model.Metadata != null)
            {
                <div class="metadata-card">
                    <div class="metadata-header">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="metadata-icon">
                            <circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
                        </svg>
                        <span class="metadata-title">Metadata</span>
                    </div>
                    <div class="metadata-grid">
                        <div class="metadata-item metadata-item-wide">
                            <span class="metadata-label">File</span>
                            <span class="metadata-value" title="@Model.Metadata.FileName">@Model.Metadata.FileName (@Model.Metadata.FileSizeFormatted)</span>
                        </div>
                        <div class="metadata-item metadata-item-wide">
                            <span class="metadata-label">Document</span>
                            <span class="metadata-value">
                                PDF @Model.Metadata.PdfVersion &bull; @Model.Metadata.PageCount Pages
                                @if (!string.IsNullOrEmpty(Model.Metadata.PageSize)) { <text>&bull; @Model.Metadata.PageSize</text> }
                                &bull; Encrypted: @(Model.Metadata.IsEncrypted ? "Yes" : "No")
                            </span>
                        </div>
                        <div class="metadata-item metadata-item-wide">
                            <span class="metadata-label">Form</span>
                            <span class="metadata-value">
                                @(Model.Metadata.HasForm ? "Yes" : "No") &bull; XFA: @(Model.Metadata.HasXfa ? "Yes" : "No") &bull; Fields: @Model.Metadata.FormFieldCount
                            </span>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Metadata.CreationDate) || !string.IsNullOrEmpty(Model.Metadata.ModDate))
                        {
                            <div class="metadata-item metadata-item-wide">
                                <span class="metadata-label">Dates</span>
                                <span class="metadata-value">
                                    @if (!string.IsNullOrEmpty(Model.Metadata.CreationDate)) { <text>Created: @Model.Metadata.CreationDate</text> }
                                    @if (!string.IsNullOrEmpty(Model.Metadata.CreationDate) && !string.IsNullOrEmpty(Model.Metadata.ModDate)) { <text>&bull;</text> }
                                    @if (!string.IsNullOrEmpty(Model.Metadata.ModDate)) { <text>Modified: @Model.Metadata.ModDate</text> }
                                </span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model.Metadata.Producer) || !string.IsNullOrEmpty(Model.Metadata.Creator))
                        {
                            <div class="metadata-item metadata-item-wide">
                                <span class="metadata-label">Origin</span>
                                <span class="metadata-value">
                                    @if (!string.IsNullOrEmpty(Model.Metadata.Producer)) { <text>Producer: @Model.Metadata.Producer</text> }
                                    @if (!string.IsNullOrEmpty(Model.Metadata.Producer) && !string.IsNullOrEmpty(Model.Metadata.Creator)) { <text>&bull;</text> }
                                    @if (!string.IsNullOrEmpty(Model.Metadata.Creator)) { <text>Creator: @Model.Metadata.Creator</text> }
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (Model.FormFields.Count == 0)
            {
                <div class="empty-state">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="empty-icon">
                        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    <h3>No Form Fields Found</h3>
                    <p>This PDF does not contain any fillable AcroForm fields.</p>
                </div>
            }
            else
            {
                <form method="post" asp-page-handler="Download" id="fieldForm">
                    <input type="hidden" name="pdfPath" value="@Model.UploadedFilePath" />

                    <div class="fields-grid">
                        @foreach (var field in Model.FormFields)
                        {
                            <div class="field-card" data-field-type="@field.FieldType">
                                <div class="field-row">
                                    <span class="field-type-badge badge-@field.FieldType.ToString().ToLower()">@field.FieldType</span>
                                    <span class="field-name" title="@field.Name">@field.Name</span>
                                    <div class="field-control">
                                        @switch (field.FieldType)
                                        {
                                            case UsefulPdfNet.Models.FormFieldType.Text:
                                                <input type="text"
                                                       name="field_@field.Name"
                                                       value="@field.CurrentValue"
                                                       class="form-control"
                                                       placeholder="Enter value..." />
                                                break;

                                            case UsefulPdfNet.Models.FormFieldType.Checkbox:
                                                <label class="checkbox-control">
                                                    <input type="hidden" name="field_@field.Name" value="Off" />
                                                    <input type="checkbox"
                                                           name="field_@field.Name"
                                                           value="Yes"
                                                           @(field.CurrentValue == "Yes" || field.CurrentValue == "On" ? "checked" : "") />
                                                    <span class="checkbox-visual"></span>
                                                </label>
                                                break;

                                            case UsefulPdfNet.Models.FormFieldType.RadioButton:
                                                <div class="radio-group">
                                                    @foreach (var option in field.Options)
                                                    {
                                                        <label class="radio-control">
                                                            <input type="radio"
                                                                   name="field_@field.Name"
                                                                   value="@option"
                                                                   @(field.CurrentValue == option ? "checked" : "") />
                                                            <span class="radio-visual"></span>
                                                            <span class="radio-label">@option</span>
                                                        </label>
                                                    }
                                                </div>
                                                break;

                                            case UsefulPdfNet.Models.FormFieldType.ComboBox:
                                            case UsefulPdfNet.Models.FormFieldType.ListBox:
                                                var isListBox = field.FieldType == UsefulPdfNet.Models.FormFieldType.ListBox;
                                                @if (isListBox)
                                                {
                                                    <select name="field_@field.Name" class="form-control" size="3">
                                                        <option value="">— Select —</option>
                                                        @foreach (var option in field.Options)
                                                        {
                                                            if (field.CurrentValue == option)
                                                            {
                                                                <option value="@option" selected>@option</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@option">@option</option>
                                                            }
                                                        }
                                                    </select>
                                                }
                                                else
                                                {
                                                    <select name="field_@field.Name" class="form-control">
                                                        <option value="">— Select —</option>
                                                        @foreach (var option in field.Options)
                                                        {
                                                            if (field.CurrentValue == option)
                                                            {
                                                                <option value="@option" selected>@option</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@option">@option</option>
                                                            }
                                                        }
                                                    </select>
                                                }
                                                break;

                                            default:
                                                <input type="text"
                                                       name="field_@field.Name"
                                                       value="@field.CurrentValue"
                                                       class="form-control"
                                                       placeholder="Enter value..." />
                                                break;
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="editor-footer">
                        <label class="checkbox-control flatten-option">
                            <input type="checkbox" name="flatten" value="true" />
                            <span class="checkbox-visual"></span>
                            <span class="checkbox-label">Flatten form (make fields non-editable)</span>
                        </label>
                        <label class="checkbox-control flatten-option" style="margin-left: 20px;">
                            <input type="checkbox" name="keepSignatures" value="true" />
                            <span class="checkbox-visual"></span>
                            <span class="checkbox-label">Keep digital signatures</span>
                        </label>
                        <button type="submit" class="btn btn-primary btn-lg">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="btn-icon">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                <polyline points="7 10 12 15 17 10"/>
                                <line x1="12" y1="15" x2="12" y2="3"/>
                            </svg>
                            Download Filled PDF
                        </button>
                    </div>
                </form>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="toast toast-error" id="errorToast">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
            </svg>
            @Model.ErrorMessage
        </div>
    }
</div>
